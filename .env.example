TZ=UTC
PUID=1000
GUID=1000

# ListenBrainz – comma-separated lists, one token per user in the same order
LB_USERS=user1,user2
LB_TOKENS=token1,token2

# Lidarr connection
LIDARR_URL=http://localhost:8686
LIDARR_API_KEY=LIDARR_API_KEY_HERE

# Required when adding new artists – adjust to your setup
LIDARR_ROOT_FOLDER=/music
LIDARR_QUALITY_PROFILE_ID=1
LIDARR_METADATA_PROFILE_ID=1

# MusicBrainz Configuration
# Set to true if you have a local MusicBrainz server
USE_LOCAL_MUSICBRAINZ=false
LOCAL_MUSICBRAINZ_URL=http://localhost:5000

# Rate Limiting Configuration
# Disable rate limiting for local servers (much faster!)
ENABLE_RATE_LIMITING=true
RATE_LIMIT_DELAY=0.5

# Performance Configuration
# Number of parallel requests (increase for faster processing)
MAX_PARALLEL_REQUESTS=10

ARTIST_INDEX_POLL_INTERVAL=5
ARTIST_INDEX_TIMEOUT=600
