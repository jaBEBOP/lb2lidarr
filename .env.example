# ---------------------------------------------------------------------------
# lb2lidarr configuration
# Copy this to .env and fill in your values
# ---------------------------------------------------------------------------

# Cron schedule for the sync (default: every 6 hours)
# Uses standard cron syntax: min hour day month weekday
CRON_SCHEDULE=0 */6 * * *

# Timezone for cron scheduling (e.g. Europe/London, America/New_York)
# Full list: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=UTC

# User and group ID to run the process as (match your host user to avoid
# permission issues on mounted volumes). Find yours with: id -u && id -g
PUID=1000
PGID=1000

# ---------------------------------------------------------------------------
# ListenBrainz
# ---------------------------------------------------------------------------
# Comma-separated list of usernames and their corresponding API tokens
LISTENBRAINZ_USERS=user1,user2
LISTENBRAINZ_TOKENS=token1,token2

# Additional ListenBrainz playlist types to fetch, on top of the defaults
# that are always included (weekly-jams, daily-jams).
# Comma-separated, e.g.: ADDITIONAL_PLAYLISTS=weekly-exploration
ADDITIONAL_PLAYLISTS=weekly-exploration

# ---------------------------------------------------------------------------
# Lidarr
# ---------------------------------------------------------------------------
LIDARR_URL=http://192.168.1.100:8686
LIDARR_API_KEY=your_api_key_here
LIDARR_ROOT_FOLDER=/music
LIDARR_QUALITY_PROFILE_ID=1
LIDARR_METADATA_PROFILE_ID=1

# ---------------------------------------------------------------------------
# MusicBrainz
# ---------------------------------------------------------------------------
# Use the public server (default) or a local mirror
MUSICBRAINZ_URL=https://musicbrainz.org
USE_LOCAL_MUSICBRAINZ=false
LOCAL_MUSICBRAINZ_URL=

# Rate limiting — disable if using a local MusicBrainz mirror
ENABLE_RATE_LIMITING=true
RATE_LIMIT_DELAY=0.5

# ---------------------------------------------------------------------------
# Performance
# ---------------------------------------------------------------------------
MAX_PARALLEL_REQUESTS=10
REQUEST_TIMEOUT=30

# How often to poll for Lidarr artist indexing to complete (seconds)
ARTIST_INDEX_POLL_INTERVAL=5
# Give up waiting for artist indexing after this many seconds
ARTIST_INDEX_TIMEOUT=300
